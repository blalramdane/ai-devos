# AI DevOS
NODE_ENV=development

# Model routing
# Providers: ollama | experiential | openai | compatible
AIDEVOS_PROVIDER=ollama
AIDEVOS_BASE_URL=http://127.0.0.1:11434/v1
AIDEVOS_API_KEY=
AIDEVOS_MODEL=qwen3:4b

# Tags used by the task-aware router for the primary route.
# Example: engineering,local
AIDEVOS_ROUTE_TAGS=engineering,local

# Optional ordered fallback routes.
# Syntax: provider:model,provider:model
# Model names may contain ':' (for example qwen3:4b).
AIDEVOS_FALLBACKS=experiential:qwen3.8-27b
AIDEVOS_FALLBACK_1_TAGS=research,cloud

# Experiential Labs
# Get the key from Experiential Labs and keep it in .env (never commit it).
# https://api.experientiallabs.ai/v1 is an OpenAI-compatible gateway.
EXPLABS_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Optional generic OpenAI-compatible provider.
AIDEVOS_COMPATIBLE_BASE_URL=
AIDEVOS_COMPATIBLE_API_KEY=
AIDEVOS_COMPATIBLE_MODEL=default

# Local state
AIDEVOS_DATA_DIR=.aidevos
AIDEVOS_MAX_TURNS=30
