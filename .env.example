# AI DevOS
NODE_ENV=development

# Model routing
# ollama | openai | compatible
AIDEVOS_PROVIDER=ollama
AIDEVOS_BASE_URL=http://127.0.0.1:11434/v1
AIDEVOS_API_KEY=ollama
AIDEVOS_MODEL=qwen3:4b

# Local state
AIDEVOS_DATA_DIR=.aidevos
AIDEVOS_MAX_TURNS=30

# For cloud/OpenAI-compatible providers:
# AIDEVOS_PROVIDER=openai
# AIDEVOS_BASE_URL=https://api.openai.com/v1
# AIDEVOS_API_KEY=your-key
# AIDEVOS_MODEL=your-model

