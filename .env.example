# AI DevOS
NODE_ENV=development
AIDEVOS_DATA_DIR=.aidevos
AIDEVOS_WORKSPACES_DIR=./workspaces
AIDEVOS_EXECUTION_MODE=sandbox

# Model routing
AIDEVOS_DEFAULT_PROVIDER=openai
AIDEVOS_OPENAI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=

# Ollama (OpenAI-compatible /v1 endpoint)
AIDEVOS_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
AIDEVOS_OLLAMA_MODEL=qwen3:4b
AIDEVOS_OLLAMA_API_KEY=ollama

# Optional LiteLLM gateway
AIDEVOS_LITELLM_BASE_URL=http://127.0.0.1:4000/v1
AIDEVOS_LITELLM_MODEL=gpt-5.6-luna
AIDEVOS_LITELLM_API_KEY=
